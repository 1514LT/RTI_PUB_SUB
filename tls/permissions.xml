<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
    <permissions>
        <!-- Publisher 权限 -->
        <grant name="PublisherPermissions">
            <subject_name>CN=Publisher,OU=Application,O=MyOrg,L=Beijing,ST=Beijing,C=CN</subject_name>
            <validity>
                <!-- 有效期：10年 -->
                <not_before>2025-01-01T00:00:00</not_before>
                <not_after>2035-01-01T00:00:00</not_after>
            </validity>
            <allow_rule>
                <domains>
                    <id>0</id>
                </domains>
                <publish>
                    <topics>
                        <topic>BasicStruct</topic>
                    </topics>
                </publish>
            </allow_rule>
            <default>DENY</default>
        </grant>

        <!-- Subscriber 权限 -->
        <grant name="SubscriberPermissions">
            <subject_name>CN=Subscriber,OU=Application,O=MyOrg,L=Beijing,ST=Beijing,C=CN</subject_name>
            <validity>
                <not_before>2025-01-01T00:00:00</not_before>
                <not_after>2035-01-01T00:00:00</not_after>
            </validity>
            <allow_rule>
                <domains>
                    <id>0</id>
                </domains>
                <subscribe>
                    <topics>
                        <topic>BasicStruct</topic>
                    </topics>
                </subscribe>
            </allow_rule>
            <default>DENY</default>
        </grant>
    </permissions>
</dds>

